#!/usr/bin/env bash
set -euo pipefail

REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
BREWFILE="$REPO/Brewfile"
STOW_DIR="$REPO/stow"
MISE_CONFIG="$STOW_DIR/common/.config/mise/config.toml"
STOW_PACKAGES=(common macos pi)
HOST_NAME=$(hostname)
HOST_PACKAGE="host-$HOST_NAME"
if [[ -d "$STOW_DIR/$HOST_PACKAGE" ]]; then
  STOW_PACKAGES+=("$HOST_PACKAGE")
fi
CHECK_ONLY=false
INSTALL_BREW=false
STOW_FAILURES=0
BREW_FAILURES=0

usage() {
  cat <<'EOF'
Usage: ./setup [--check] [--brew]

  --check  validate Stow, mise, and the environment without changing files
  --brew   install applications and tools from Brewfile, without stowing files
EOF
}

fail() {
  printf 'setup: ERROR: %s\n' "$*" >&2
  exit 1
}

warn() {
  printf 'setup: WARNING: %s\n' "$*" >&2
}

require_command() {
  local command_name=$1
  command -v "$command_name" >/dev/null 2>&1 || fail "$command_name is not installed"
}

check_homebrew_bundle() {
  if ! command -v brew >/dev/null 2>&1; then
    warn "Homebrew is not installed; skipping Brewfile check"
    return 0
  fi

  [[ -f "$BREWFILE" ]] || fail "Brewfile is missing: $BREWFILE"

  if ! HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_ENV_HINTS=1 brew bundle check --file="$BREWFILE"; then
    warn "Homebrew bundle is not complete; run ./setup --brew"
    BREW_FAILURES=$((BREW_FAILURES + 1))
  fi
}

install_homebrew_bundle() {
  require_command brew
  [[ -f "$BREWFILE" ]] || fail "Brewfile is missing: $BREWFILE"

  printf 'Installing applications and tools from %s...\n' "$BREWFILE"
  HOMEBREW_NO_AUTO_UPDATE=1 brew bundle install --file="$BREWFILE"
  printf 'Homebrew setup complete.\n'
}

stow_command() {
  stow --no-folding --target="$HOME" --dir="$STOW_DIR" "$@"
}

check_stow() {
  require_command stow
  [[ -d "$STOW_DIR" ]] || fail "Stow directory is missing: $STOW_DIR"

  if ! stow_command --simulate --verbose=1 "${STOW_PACKAGES[@]}"; then
    warn "Stow found conflicting home paths; no files were changed"
    warn "Resolve, remove, or intentionally adopt the conflicts, then rerun ./setup"
    STOW_FAILURES=$((STOW_FAILURES + 1))
  fi
}

check_mise() {
  require_command mise
  [[ -f "$MISE_CONFIG" ]] || fail "mise configuration is missing: $MISE_CONFIG"
  mise config get --file "$MISE_CONFIG" tools >/dev/null
}

apply_stow() {
  if ! stow_command --simulate --verbose=1 "${STOW_PACKAGES[@]}"; then
    fail "Stow found conflicts; resolve, remove, or intentionally adopt them, then rerun ./setup"
  fi

  stow_command "${STOW_PACKAGES[@]}"
}

while (($#)); do
  case "$1" in
    --check)
      CHECK_ONLY=true
      ;;
    --brew)
      INSTALL_BREW=true
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    *)
      printf 'setup: ERROR: unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

if (($#)); then
  printf 'setup: ERROR: unexpected argument: %s\n' "$1" >&2
  usage >&2
  exit 2
fi

[[ "$(uname -s)" == "Darwin" ]] || fail "this profile supports macOS only"
[[ "$(uname -m)" == "arm64" ]] || fail "this profile supports Apple Silicon only"

if [[ "$INSTALL_BREW" == true ]]; then
  if [[ "$CHECK_ONLY" == true ]]; then
    check_homebrew_bundle
    (( BREW_FAILURES == 0 )) || fail "Homebrew bundle check failed"
    printf 'Homebrew check complete. No files or applications were changed.\n'
  else
    install_homebrew_bundle
  fi
  exit 0
fi

check_stow
check_mise

if [[ "$CHECK_ONLY" == true ]]; then
  (( STOW_FAILURES == 0 )) || fail "Stow check failed"
  printf 'Check complete. No files or applications were changed.\n'
  exit 0
fi

apply_stow
mise install
printf 'Dotfiles stowed and mise tools installed.\n'
