#!/usr/bin/env bash
set -euo pipefail

REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
BREWFILE="$REPO/Brewfile"
CHECK_ONLY=false
INSTALL_BREW=false

usage() {
  cat <<'EOF'
Usage: ./setup --brew [--check]

  --brew   install applications from Brewfile, without running mise bootstrap
  --check  check the Brewfile without installing applications

Mise is the primary setup interface. Use `mise bootstrap` for tools and
configuration; this command remains only for the Homebrew-managed GUI casks.
EOF
}

fail() {
  printf 'setup: ERROR: %s\n' "$*" >&2
  exit 1
}

require_command() {
  local command_name=$1
  command -v "$command_name" >/dev/null 2>&1 || fail "$command_name is not installed"
}

check_homebrew_bundle() {
  require_command brew
  [[ -f "$BREWFILE" ]] || fail "Brewfile is missing: $BREWFILE"

  if ! HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_ENV_HINTS=1 brew bundle check --file="$BREWFILE"; then
    fail "Homebrew bundle check failed"
  fi
}

install_homebrew_bundle() {
  require_command brew
  [[ -f "$BREWFILE" ]] || fail "Brewfile is missing: $BREWFILE"

  printf 'Installing GUI applications from %s...\n' "$BREWFILE"
  HOMEBREW_NO_AUTO_UPDATE=1 brew bundle install --file="$BREWFILE"
  printf 'Homebrew setup complete.\n'
}

while (($#)); do
  case "$1" in
    --check)
      CHECK_ONLY=true
      ;;
    --brew)
      INSTALL_BREW=true
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    *)
      printf 'setup: ERROR: unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

if (($#)); then
  printf 'setup: ERROR: unexpected argument: %s\n' "$1" >&2
  usage >&2
  exit 2
fi

[[ "$(uname -s)" == "Darwin" ]] || fail "this profile supports macOS only"
[[ "$(uname -m)" == "arm64" ]] || fail "this profile supports Apple Silicon only"

if [[ "$INSTALL_BREW" != true ]]; then
  usage >&2
  exit 2
fi

if [[ "$CHECK_ONLY" == true ]]; then
  check_homebrew_bundle
  printf 'Homebrew check complete. No applications were changed.\n'
else
  install_homebrew_bundle
fi
