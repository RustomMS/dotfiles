#!/usr/bin/env bash
set -euo pipefail

REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
BREWFILE="$REPO/Brewfile"
STOW_DIR="$REPO/stow"
MISE_CONFIG="$STOW_DIR/common/.config/mise/config.toml"
PI_AGENT_CONFIG_DIR="$STOW_DIR/pi/.pi/agent"
PI_AGENT_DIR="$HOME/.pi/agent"
PI_BACKUP_DIR="$HOME/.pi-config-backups"
STOW_PACKAGES=(common macos)
HOST_NAME=$(hostname)
HOST_PACKAGE="host-$HOST_NAME"
if [[ -d "$STOW_DIR/$HOST_PACKAGE" ]]; then
  STOW_PACKAGES+=("$HOST_PACKAGE")
fi
CHECK_ONLY=false
INSTALL_BREW=false
STOW_FAILURES=0
BREW_FAILURES=0

usage() {
  cat <<'EOF'
Usage: ./setup [--check] [--brew]

  --check  validate Stow, mise, Pi configuration, and the environment without changing files
  --brew   install applications and tools from Brewfile, without stowing files

Pi configuration files are linked individually. Pi authentication, model cache,
sessions, and skills remain in ~/.pi/agent. Existing Pi config files are backed
up under ~/.pi-config-backups before they are replaced.
EOF
}

fail() {
  printf 'setup: ERROR: %s\n' "$*" >&2
  exit 1
}

warn() {
  printf 'setup: WARNING: %s\n' "$*" >&2
}

require_command() {
  local command_name=$1
  command -v "$command_name" >/dev/null 2>&1 || fail "$command_name is not installed"
}

check_homebrew_bundle() {
  if ! command -v brew >/dev/null 2>&1; then
    warn "Homebrew is not installed; skipping Brewfile check"
    return 0
  fi

  [[ -f "$BREWFILE" ]] || fail "Brewfile is missing: $BREWFILE"

  if ! HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_ENV_HINTS=1 brew bundle check --file="$BREWFILE"; then
    warn "Homebrew bundle is not complete; run ./setup --brew"
    BREW_FAILURES=$((BREW_FAILURES + 1))
  fi
}

install_homebrew_bundle() {
  require_command brew
  [[ -f "$BREWFILE" ]] || fail "Brewfile is missing: $BREWFILE"

  printf 'Installing applications and tools from %s...\n' "$BREWFILE"
  HOMEBREW_NO_AUTO_UPDATE=1 brew bundle install --file="$BREWFILE"
  printf 'Homebrew setup complete.\n'
}

stow_command() {
  stow --no-folding --target="$HOME" --dir="$STOW_DIR" "$@"
}

check_pi_package() {
  [[ -d "$PI_AGENT_CONFIG_DIR" ]] || fail "Pi configuration directory is missing: $PI_AGENT_CONFIG_DIR"

  local path relative_path
  while IFS= read -r -d '' path; do
    relative_path=${path#"$PI_AGENT_CONFIG_DIR/"}
    case "$relative_path" in
      settings.json|models.json|cache-keep-live.json|extensions/*.ts|themes/*.json)
        ;;
      *)
        fail "unsupported file in Pi package: stow/pi/.pi/agent/$relative_path"
        ;;
    esac
  done < <(find "$PI_AGENT_CONFIG_DIR" -type f -print0)
}

check_pi_config() {
  check_pi_package
  [[ -d "$PI_AGENT_DIR" ]] || {
    printf 'Pi config: create %s\n' "$PI_AGENT_DIR"
    return 0
  }

  local source relative_path target
  while IFS= read -r -d '' source; do
    relative_path=${source#"$PI_AGENT_CONFIG_DIR/"}
    target="$PI_AGENT_DIR/$relative_path"
    if [[ -L "$target" && "$(readlink "$target")" == "$source" ]]; then
      continue
    elif [[ -e "$target" || -L "$target" ]]; then
      printf 'Pi config: back up and link %s\n' "$target"
    else
      printf 'Pi config: link %s\n' "$target"
    fi
  done < <(find "$PI_AGENT_CONFIG_DIR" -type f -print0)
}

sync_pi_config() {
  local backup_stamp
  backup_stamp=$(date +%Y%m%d-%H%M%S)

  local source relative_path target backup_path
  while IFS= read -r -d '' source; do
    relative_path=${source#"$PI_AGENT_CONFIG_DIR/"}
    target="$PI_AGENT_DIR/$relative_path"

    if [[ -L "$target" && "$(readlink "$target")" == "$source" ]]; then
      continue
    elif [[ -e "$target" || -L "$target" ]]; then
      backup_path="$PI_BACKUP_DIR/$backup_stamp/$relative_path"
      mkdir -p "$(dirname "$backup_path")"
      mv "$target" "$backup_path"
      printf 'Backed up existing Pi config: %s\n' "$target"
    fi

    mkdir -p "$(dirname "$target")"
    ln -s "$source" "$target"
    printf 'Linked Pi config: %s\n' "$target"
  done < <(find "$PI_AGENT_CONFIG_DIR" -type f -print0)
}

check_stow() {
  require_command stow
  [[ -d "$STOW_DIR" ]] || fail "Stow directory is missing: $STOW_DIR"

  if ! stow_command --simulate --verbose=1 "${STOW_PACKAGES[@]}"; then
    warn "Stow found conflicting home paths; no files were changed"
    warn "Resolve, remove, or intentionally adopt the conflicts, then rerun ./setup"
    STOW_FAILURES=$((STOW_FAILURES + 1))
  fi
}

check_mise() {
  require_command mise
  [[ -f "$MISE_CONFIG" ]] || fail "mise configuration is missing: $MISE_CONFIG"
  mise config get --file "$MISE_CONFIG" tools >/dev/null
}

apply_stow() {
  if ! stow_command --simulate --verbose=1 "${STOW_PACKAGES[@]}"; then
    fail "Stow found conflicts; resolve, remove, or intentionally adopt them, then rerun ./setup"
  fi

  stow_command "${STOW_PACKAGES[@]}"
}

while (($#)); do
  case "$1" in
    --check)
      CHECK_ONLY=true
      ;;
    --brew)
      INSTALL_BREW=true
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    *)
      printf 'setup: ERROR: unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

if (($#)); then
  printf 'setup: ERROR: unexpected argument: %s\n' "$1" >&2
  usage >&2
  exit 2
fi

[[ "$(uname -s)" == "Darwin" ]] || fail "this profile supports macOS only"
[[ "$(uname -m)" == "arm64" ]] || fail "this profile supports Apple Silicon only"

if [[ "$INSTALL_BREW" == true ]]; then
  if [[ "$CHECK_ONLY" == true ]]; then
    check_homebrew_bundle
    (( BREW_FAILURES == 0 )) || fail "Homebrew bundle check failed"
    printf 'Homebrew check complete. No files or applications were changed.\n'
  else
    install_homebrew_bundle
  fi
  exit 0
fi

check_pi_config
check_stow
check_mise

if [[ "$CHECK_ONLY" == true ]]; then
  (( STOW_FAILURES == 0 )) || fail "Stow check failed"
  printf 'Check complete. No files or applications were changed.\n'
  exit 0
fi

apply_stow
sync_pi_config
mise install
printf 'Dotfiles stowed, Pi configuration synced, and mise tools installed.\n'
